# Required for Qwen-Flash / DashScope
DASHSCOPE_API_KEY=

# Optional: cap general-agent prompt size when the consolidated payload is huge
# PROOFREADER_GENERAL_USER_MAX_CHARS=200000

# Soft rules (optional — enable per request via run_proofreader or portal toggle)
# AGENTIC_SOFT_RULES_URL=https://example.com/soft-rules.json
# AGENTIC_SOFT_RULES_PATH=/absolute/or/relative/path/to/soft-rules.json

# Optional rendering caps for soft-rule snippets
# AGENTIC_SOFT_RULES_MAX_EVIDENCE_LINES=3
# AGENTIC_SOFT_RULES_EVIDENCE_CONTEXT_MAX_CHARS=140

# Langfuse (optional — if using hosted prompts)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
